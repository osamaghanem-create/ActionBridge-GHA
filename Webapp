.risk-gauge { align-self: center; text-align: center; position: relative; z-index: 1; }
.gauge-ring { margin: auto; width: 128px; height: 128px; border-radius: 50%; display: grid; place-items: center; align-content: center; border: 10px solid rgba(255,255,255,.2); border-top-color: white; transform: rotate(22deg); }
.gauge-ring span, .gauge-ring small { transform: rotate(-22deg); }
.gauge-ring span { font-size: 38px; font-weight: 800; line-height: 1; }
.gauge-ring small { margin-top: 4px; opacity: .7; }
.risk-gauge p { font-size: 12px; margin-top: 10px; }
.metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 18px 0; }
.metric-card { background: white; border: 1px solid var(--line); border-radius: 15px; padding: 18px; display: flex; gap: 14px; align-items: center; box-shadow: 0 6px 18px rgba(15,69,63,.04); }
.metric-icon { width: 42px; height: 42px; border-radius: 12px; background: #e9f4f1; color: var(--brand-2); display: grid; place-items: center; font-weight: 900; }
.metric-card small { color: var(--muted); display: block; font-size: 11px; }
.metric-card strong { display: block; font-size: 25px; margin-top: 2px; }
.metric-card p { margin: 2px 0 0; color: var(--muted); font-size: 10px; }
.alert-metric .metric-icon { background: #fff0e9; color: #bd5639; }
.content-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .8fr); gap: 18px; }
.panel { background: white; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 7px 22px rgba(15,69,63,.045); }
.panel-header { padding: 18px 20px 12px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.panel-header h3 { margin: 0; font-size: 16px; }
.panel-header span { color: var(--muted); font-size: 11px; }
.legend { display: flex; gap: 10px; font-size: 10px; color: var(--muted); }
.legend span { display: flex; align-items: center; gap: 4px; }
.dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
.dot.red { background: var(--danger); } .dot.amber { background: var(--warning); } .dot.green { background: var(--success); }
.map-canvas { margin: 0 14px 14px; position: relative; overflow: hidden; border-radius: 13px; border: 1px solid #e1e8e4; }
.map-canvas svg { width: 100%; display: block; }
.community-marker { cursor: pointer; }
.community-marker text { font-size: 12px; font-weight: 750; fill: #274441; paint-order: stroke; stroke: #f6faf8; stroke-width: 4px; stroke-linejoin: round; }
.map-tooltip { position: absolute; display: none; background: #163f3b; color: white; padding: 9px 11px; border-radius: 8px; font-size: 11px; pointer-events: none; box-shadow: 0 6px 16px rgba(0,0,0,.18); }
.live-pill { color: #1d7d67 !important; background: #e6f5f0; padding: 5px 8px; border-radius: 99px; font-weight: 800; letter-spacing: .8px; }
.progress-item { padding: 7px 20px 10px; }
.progress-item div { display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 7px; }
.progress-item strong { color: var(--brand); }
progress { width: 100%; height: 8px; border: 0; border-radius: 99px; overflow: hidden; }
progress::-webkit-progress-bar { background: #edf2f0; }
progress::-webkit-progress-value { background: linear-gradient(90deg, var(--brand-2), #52b99d); border-radius: 99px; transition: width .45s; }
.response-list { padding: 9px 16px 16px; max-height: 270px; overflow: auto; }
.empty-state { min-height: 155px; display: grid; place-items: center; align-content: center; text-align: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 12px; padding: 20px; }
.empty-state span { font-size: 28px; margin-bottom: 7px; }
.empty-state p { font-size: 11px; line-height: 1.5; margin: 0; }
.response-row { display: grid; grid-template-columns: 32px 1fr auto; gap: 10px; align-items: center; padding: 10px 3px; border-bottom: 1px solid #edf1ef; }
.response-row:last-child { border-bottom: 0; }
.response-avatar { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: #eaf4f1; color: var(--brand); font-size: 10px; font-weight: 800; }
.response-row strong { font-size: 11px; display: block; }
.response-row small { font-size: 10px; color: var(--muted); }
.status-chip { padding: 4px 7px; border-radius: 99px; font-size: 9px; font-weight: 800; }
.status-chip.completed { background: #e4f5ee; color: #1c745f; }
.status-chip.help { background: #fff0e9; color: #b65337; }
.status-chip.ack { background: #fff6dc; color: #93620a; }
.quick-actions-panel { margin-top: 18px; }
.text-button { border: 0; background: transparent; color: var(--brand-2); font-weight: 750; font-size: 11px; }
.action-card-grid { padding: 0 18px 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; }
.action-card { border: 1px solid var(--line); border-radius: 13px; padding: 15px; position: relative; transition: .2s; }
.action-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(15,69,63,.07); }
.action-card h4 { margin: 10px 0 6px; font-size: 14px; }
.action-card p { margin: 0; font-size: 11px; color: var(--muted); line-height: 1.5; }
.role-icon { width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; background: #e9f4f1; color: var(--brand); font-weight: 800; }
.action-card footer { margin-top: 12px; padding-top: 10px; border-top: 1px solid #edf1ef; display: flex; justify-content: space-between; align-items: center; }
.action-card footer span { font-size: 9px; color: var(--muted); }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 18px; }
.section-heading h3 { margin: 0; font-size: 24px; }
.section-heading > div > p:last-child { color: var(--muted); font-size: 12px; margin: 7px 0 0; }
.two-column-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.alert-form-panel, .json-panel { padding-bottom: 20px; }
.form-grid { padding: 4px 20px 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
.form-grid label { display: grid; gap: 6px; font-size: 11px; color: var(--muted); }
.form-grid .full { grid-column: 1 / -1; }
input, select, textarea { border: 1px solid var(--line); border-radius: 9px; padding: 10px 11px; background: #fbfcfc; color: var(--ink); outline: none; }
input:focus, select:focus, textarea:focus { border-color: #70a99f; box-shadow: 0 0 0 3px rgba(22,125,108,.08); }
textarea { min-height: 90px; resize: vertical; }
.source-check { margin: 0 20px 14px; padding: 12px; display: flex; align-items: center; gap: 10px; border-radius: 10px; background: #edf7f3; color: var(--success); }
.source-check span { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: white; font-weight: 800; }
.source-check strong { font-size: 11px; }
.source-check p { margin: 2px 0 0; color: #4d716b; font-size: 10px; }
.full-width { width: calc(100% - 40px); margin: 0 20px; }
pre { margin: 5px 20px 0; padding: 16px; border-radius: 12px; background: #0f2f2c; color: #d8f1e8; min-height: 405px; overflow: auto; font-size: 11px; line-height: 1.6; }
.filter-row { display: flex; gap: 7px; }
.filter { border: 1px solid var(--line); padding: 8px 11px; border-radius: 99px; background: white; color: var(--muted); font-size: 10px; }
.filter.active { background: var(--brand); color: white; border-color: var(--brand); }
.playbook-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
.playbook-card { background: white; border: 1px solid var(--line); border-radius: 15px; overflow: hidden; box-shadow: 0 7px 22px rgba(15,69,63,.04); }
.playbook-top { padding: 17px; display: flex; justify-content: space-between; align-items: start; }
.playbook-top h4 { margin: 9px 0 4px; }
.playbook-top p { margin: 0; font-size: 10px; color: var(--muted); }
.playbook-version { font-size: 9px; padding: 4px 7px; border-radius: 99px; background: #edf4f2; color: var(--brand); }
.playbook-list { list-style: none; margin: 0; padding: 0 17px 14px; }
.playbook-list li { padding: 9px 0 9px 22px; border-top: 1px solid #eef2f0; font-size: 11px; line-height: 1.45; position: relative; }
.playbook-list li:before { content: "✓"; position: absolute; left: 0; color: var(--success); font-weight: 800; }
.playbook-footer { padding: 12px 17px; background: #f7faf9; display: flex; justify-content: space-between; align-items: center; font-size: 9px; color: var(--muted); }
.table-panel { overflow: hidden; }
.table-wrapper { overflow: auto; }
table { width: 100%; border-collapse: collapse; min-width: 760px; }
th { text-align: left; padding: 12px 15px; background: #f7faf9; font-size: 10px; color: var(--muted); letter-spacing: .4px; }
td { padding: 14px 15px; border-top: 1px solid #edf1ef; font-size: 11px; }
.risk-label { font-weight: 800; }
.risk-label.high { color: var(--danger); } .risk-label.medium { color: #c17b15; } .risk-label.low { color: var(--success); }
.analytics-grid { display: grid; grid-template-columns: 1.4fr .8fr; gap: 16px; }
.funnel-panel, .score-panel, .timeline-panel, .safeguards-panel { min-height: 280px; }
.funnel { padding: 6px 20px 20px; display: grid; gap: 8px; }
.funnel-row { display: grid; grid-template-columns: 130px 1fr 42px; gap: 10px; align-items: center; font-size: 11px; }
.funnel-bar { height: 27px; background: #edf2f0; border-radius: 6px; overflow: hidden; }
.funnel-fill { height: 100%; background: linear-gradient(90deg, var(--brand), #4eb195); transition: width .45s; }
.score-panel { text-align: center; }
.score-circle { width: 150px; height: 150px; border-radius: 50%; margin: 14px auto 12px; display: grid; place-items: center; align-content: center; border: 15px solid #e7f1ee; border-top-color: var(--brand-2); }
.score-circle strong { font-size: 42px; line-height: 1; }
.score-circle span { font-size: 12px; color: var(--muted); }
.score-panel > p { padding: 0 25px; font-size: 11px; color: var(--muted); line-height: 1.5; }
.timeline { padding: 0 20px 20px; }
.timeline-item { display: grid; grid-template-columns: 12px 1fr; gap: 10px; padding: 0 0 16px; position: relative; }
.timeline-item:before { content: ""; position: absolute; width: 1px; background: #d9e6e2; left: 5px; top: 12px; bottom: 0; }
.timeline-item:last-child:before { display: none; }
.timeline-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--brand-2); margin-top: 3px; z-index: 1; }
.timeline-item strong { font-size: 11px; }
.timeline-item p { margin: 2px 0 0; font-size: 10px; color: var(--muted); }
.check-list { list-style: none; padding: 5px 20px 20px; margin: 0; }
.check-list li { padding: 10px 0 10px 26px; border-bottom: 1px solid #edf1ef; font-size: 11px; position: relative; }
.check-list li:before { content: "✓"; position: absolute; left: 0; width: 17px; height: 17px; border-radius: 50%; display: grid; place-items: center; background: #e5f5ef; color: var(--success); font-size: 9px; font-weight: 800; }
.modal-backdrop { position: fixed; inset: 0; background: rgba(7,39,36,.58); backdrop-filter: blur(4px); display: grid; place-items: center; z-index: 100; padding: 20px; }
.modal { position: relative; width: min(680px, 100%); max-height: 88vh; overflow: auto; background: white; border-radius: 18px; padding: 25px; box-shadow: 0 30px 90px rgba(0,0,0,.3); }
.modal-close { position: absolute; top: 12px; right: 14px; width: 34px; height: 34px; border-radius: 50%; border: 0; background: #edf3f1; font-size: 20px; }
.modal h3 { margin-top: 0; }
.modal p, .modal li { font-size: 12px; color: var(--muted); line-height: 1.6; }
.sms-phone { width: 310px; max-width: 100%; margin: 10px auto; border: 8px solid #183a37; border-radius: 30px; background: #f4f7f6; overflow: hidden; box-shadow: 0 14px 34px rgba(0,0,0,.14); }
.phone-top { background: #183a37; color: white; text-align: center; padding: 6px; font-size: 10px; }
.sms-screen { padding: 16px; min-height: 330px; }
.message-bubble { background: white; border-radius: 13px 13px 13px 3px; padding: 12px; font-size: 11px; line-height: 1.5; box-shadow: 0 4px 14px rgba(0,0,0,.07); }
.sms-options { display: grid; gap: 8px; margin-top: 14px; }
.sms-options button { border: 1px solid var(--line); background: white; border-radius: 9px; padding: 10px; text-align: left; font-size: 11px; }
.sms-options button:hover { border-color: var(--brand-2); background: #edf7f4; }
.toast { position: fixed; right: 24px; bottom: 24px; background: #163f3b; color: white; padding: 12px 15px; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.2); opacity: 0; transform: translateY(10px); pointer-events: none; transition: .25s; z-index: 120; font-size: 12px; }
.toast.show { opacity: 1; transform: translateY(0); }
.tour-highlight { outline: 4px solid rgba(232,181,75,.7) !important; box-shadow: 0 0 0 8px rgba(232,181,75,.18), var(--shadow) !important; position: relative; z-index: 30; }
