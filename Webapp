<index.html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b4f4a" />
  <meta name="description" content="ActionBridge GHA turns trusted early warnings into assigned and verified early action." />
  <title>ActionBridge GHA</title>
  <style>
:root {
