  qs('#activateAlert').textContent = 'Response plan active';
  qs('#activateAlert').disabled = true;

  const steps = [
    { delay: 500, delivered: 64, ack: 0, complete: 0, help: 0, event: ['First warning batch delivered', '5,389 people reached by SMS and PWA'] },
    { delay: 1300, delivered: 96, ack: 38, complete: 12, help: 0, response: ['Amina Hassan', 'Afgooye', 'ack'], event: ['First community acknowledgement', 'Afgooye household confirmed receipt'] },
    { delay: 2200, delivered: 98, ack: 63, complete: 41, help: 1, response: ['Mohamed Ali', 'Qoryoley', 'help'], event: ['Assistance request received', 'Transport required for an older resident in Qoryoley'] },
