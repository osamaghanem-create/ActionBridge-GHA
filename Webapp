  ];
  steps.forEach(s => setTimeout(() => {
    state.delivered = s.delivered; state.acknowledged = s.ack; state.completed = s.complete; state.help = s.help;
    if (s.response) addResponse(...s.response);
    if (s.event) state.timeline.push({ title: s.event[0], detail: s.event[1] });
    communities.forEach((c, i) => { c.ack = Math.max(0, Math.min(100, s.ack - i * 5)); c.status = i === 1 && s.help ? 'Needs help' : c.ack > 0 ? 'Responded' : 'Awaiting response'; });
    updateDashboard();
  }, s.delay));
}

