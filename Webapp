.brand-mark { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; font-weight: 800; background: linear-gradient(135deg, #f1c45f, #d99e2c); color: #173c38; box-shadow: 0 8px 20px rgba(0,0,0,.18); }
.brand h1 { font-size: 19px; margin: 0; letter-spacing: .2px; }
