.nav-item:hover, .nav-item.active { background: rgba(255,255,255,.1); color: #fff; }
.nav-item span { width: 22px; text-align: center; }
.sidebar-card { margin-top: auto; display: flex; gap: 10px; align-items: center; padding: 13px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1); border-radius: 12px; }
.status-dot { width: 9px; height: 9px; background: #5de1a9; border-radius: 50%; box-shadow: 0 0 0 5px rgba(93,225,169,.12); }
.sidebar-card strong { font-size: 13px; display: block; }
.sidebar-card small { display: block; font-size: 11px; opacity: .66; margin-top: 2px; }
.demo-button { border: 1px solid rgba(255,255,255,.18); background: transparent; color: white; padding: 11px 14px; border-radius: 10px; }
