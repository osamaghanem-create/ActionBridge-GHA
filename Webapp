  .language-select span { display: none; }
}

</style>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar" aria-label="Primary navigation">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">AB</div>
        <div>
          <h1>ActionBridge</h1>
          <p>Greater Horn of Africa</p>
        </div>
      </div>

      <nav class="nav-list">
        <button class="nav-item active" data-view="dashboard"><span>◫</span> Command Center</button>
        <button class="nav-item" data-view="alerts"><span>⚠</span> Alerts</button>
        <button class="nav-item" data-view="actions"><span>✓</span> Action Playbooks</button>
        <button class="nav-item" data-view="communities"><span>⌖</span> Communities</button>
        <button class="nav-item" data-view="analytics"><span>↗</span> Impact Analytics</button>
      </nav>

      <div class="sidebar-card">
        <span class="status-dot"></span>
        <div>
          <strong>Prototype online</strong>
          <small>Demo data · Flood scenario</small>
        </div>
      </div>

      <button class="demo-button" id="startTour">▶ Start guided demo</button>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div>
          <p class="eyebrow">EARLY WARNING → EARLY ACTION</p>
          <h2 id="pageTitle">Regional Command Center</h2>
        </div>
        <div class="topbar-actions">
          <label class="language-select">
            <span>Language</span>
            <select id="languageSelector" aria-label="Interface language">
              <option value="en">English</option>
              <option value="sw">Kiswahili</option>
              <option value="so">Soomaali</option>
            </select>
          </label>
          <button class="icon-button" id="resetDemo" title="Reset prototype">↻</button>
          <div class="avatar">OG</div>
        </div>
      </header>

      <section class="view active" id="dashboardView">
        <div class="hero-alert">
          <div class="hero-copy">
            <div class="badge danger">SEVERE FLOOD WARNING</div>
            <h3>Lower Shabelle River Basin</h3>
            <p>Heavy rainfall and rising river levels may cause flooding in low-lying communities within the next 18 hours.</p>
            <div class="hero-meta">
              <span><b>Source:</b> Regional Flood Coordination Desk</span>
              <span><b>Issued:</b> 24 Jul 2026 · 08:30 EAT</span>
              <span><b>Confidence:</b> High</span>
            </div>
            <div class="hero-actions">
              <button class="primary" id="activateAlert">Activate response plan</button>
              <button class="secondary" id="viewAlertDetails">View alert details</button>
            </div>
          </div>
          <div class="risk-gauge" aria-label="Risk score 86 out of 100">
            <div class="gauge-ring">
              <span>86</span>
              <small>Risk score</small>
            </div>
            <p>Immediate early action recommended</p>
          </div>
        </div>

