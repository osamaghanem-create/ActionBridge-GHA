  alertPayload.info.event = qs('#hazardType').value;
  alertPayload.info.severity = qs('#severity').value;
  alertPayload.info.urgency = qs('#urgency').value;
  alertPayload.info.area.areaDesc = qs('#affectedArea').value;
  alertPayload.info.headline = `${qs('#severity').value} ${qs('#hazardType').value.toLowerCase()} warning for ${qs('#affectedArea').value}`;
  qs('#alertJson').textContent = JSON.stringify(alertPayload, null, 2);
}

function download(filename, content, type='text/plain') {
  const blob = new Blob([content], { type });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = filename; a.click();
  URL.revokeObjectURL(url);
}

function resetDemo() {
  Object.assign(state, { activated: false, delivered: 0, acknowledged: 0, completed: 0, resolved: 0, help: 0, timeline: [
    { title: 'Official flood alert received', detail: 'Source verified · 08:30 EAT' },
    { title: 'Geographic exposure calculated', detail: '12 communities and 8,420 people identified' }
  ] });
  communities.forEach(c => { c.ack = 0; c.status = c.risk === 'Low' ? 'Monitoring' : 'Awaiting activation'; });
  qs('#activateAlert').textContent = 'Activate response plan'; qs('#activateAlert').disabled = false;
  qs('#responseList').innerHTML = '<div class="empty-state"><span>◌</span><p>Activate the response plan to begin sending role-specific instructions.</p></div>';
  updateDashboard();
  showToast('Prototype reset.');
}

function startTour() {
  setView('dashboard');
  const targets = ['.hero-alert', '.map-panel', '.quick-actions-panel', '.response-panel'];
  let i = 0;
  const next = () => {
    qsa('.tour-highlight').forEach(x => x.classList.remove('tour-highlight'));
    if (i >= targets.length) { showToast('Guided demo complete. Activate the response plan to continue.'); return; }
    const el = qs(targets[i]); el.classList.add('tour-highlight'); el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const messages = ['1/4 Review the official severe flood warning.', '2/4 See which communities are exposed.', '3/4 Inspect role-specific action cards.', '4/4 Monitor acknowledgements and action completion.'];
    showToast(messages[i]); i += 1; setTimeout(next, 2400);
  };
  next();
}

qsa('.nav-item').forEach(btn => btn.addEventListener('click', () => setView(btn.dataset.view)));
qs('#activateAlert').addEventListener('click', activateResponse);
qs('#viewAlertDetails').addEventListener('click', () => { setView('alerts'); updateJson(); });
qs('#openAllActions').addEventListener('click', () => setView('actions'));
qs('#languageSelector').addEventListener('change', e => { state.language = e.target.value; renderActionCards(); showToast(`Language changed to ${e.target.selectedOptions[0].text}.`); });
qs('#closeModal').addEventListener('click', closeModal);
qs('#modalBackdrop').addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
qs('#resetDemo').addEventListener('click', resetDemo);
qs('#startTour').addEventListener('click', startTour);
qs('#validateAlert').addEventListener('click', () => { updateJson(); showToast('Alert validated. Three role-based playbooks generated.'); setTimeout(() => setView('actions'), 700); });
qs('#importSampleAlert').addEventListener('click', () => { updateJson(); showToast('Sample CAP alert imported.'); });
qs('#copyJson').addEventListener('click', async () => { await navigator.clipboard.writeText(qs('#alertJson').textContent); showToast('Structured alert copied.'); });
qs('#addCommunity').addEventListener('click', () => openModal('<p class="eyebrow">COMMUNITY REGISTRY</p><h3>Prototype data entry</h3><p>This demo uses a fixed set of sample communities. In production, authorized users would add location coordinates, population, vulnerable groups, preferred communication channels, and evacuation points.</p>'));
qs('#downloadReport').addEventListener('click', () => {
  const report = `ActionBridge GHA Demo Report\n\nDelivered: ${state.delivered}%\nAcknowledged: ${state.acknowledged}%\nActions completed: ${state.completed}%\nAssistance requests: ${state.help}\nResolved: ${state.resolved}%\n\nGenerated: ${new Date().toISOString()}`;
  download('actionbridge-demo-report.txt', report);
});

qsa('.filter').forEach(btn => btn.addEventListener('click', () => {
  qsa('.filter').forEach(x => x.classList.remove('active')); btn.classList.add('active');
  qsa('.playbook-card').forEach(card => card.style.display = btn.dataset.roleFilter === 'all' || card.dataset.role === btn.dataset.roleFilter ? '' : 'none');
}));

qsa('.community-marker').forEach(marker => {
  marker.addEventListener('mouseenter', e => {
    const c = communities.find(x => marker.dataset.community.startsWith(x.name.split(' ')[0])) || communities[0];
    const tooltip = qs('#mapTooltip'); tooltip.innerHTML = `<strong>${marker.dataset.community}</strong><br>${c.risk} risk · ${c.population.toLocaleString()} people`;
    tooltip.style.display = 'block';
  });
  marker.addEventListener('mousemove', e => { const rect = qs('#mapCanvas').getBoundingClientRect(); qs('#mapTooltip').style.left = `${e.clientX - rect.left + 12}px`; qs('#mapTooltip').style.top = `${e.clientY - rect.top + 12}px`; });
  marker.addEventListener('mouseleave', () => qs('#mapTooltip').style.display = 'none');
  marker.addEventListener('click', () => openSmsSimulation());
});

['#hazardType','#severity','#urgency','#affectedArea'].forEach(sel => qs(sel).addEventListener('input', updateJson));

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

renderActionCards();
renderCommunities();
updateJson();
updateDashboard();



</script>
</body>
</html>
