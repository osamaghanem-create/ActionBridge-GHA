.avatar { width: 39px; height: 39px; border-radius: 50%; display: grid; place-items: center; color: white; background: var(--brand); font-size: 12px; font-weight: 800; }
.view { display: none; padding: 26px 30px 48px; }
.view.active { display: block; }
.hero-alert { display: grid; grid-template-columns: 1fr 240px; gap: 24px; padding: 27px 30px; background: linear-gradient(135deg, #702f31, #a83b3f 65%, #c95b50); color: white; border-radius: 20px; box-shadow: var(--shadow); position: relative; overflow: hidden; }
.hero-alert:after { content: ""; position: absolute; width: 320px; height: 320px; border-radius: 50%; border: 50px solid rgba(255,255,255,.05); right: -110px; top: -120px; }
.hero-copy { position: relative; z-index: 1; }
.badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 99px; font-size: 9px; font-weight: 850; letter-spacing: 1.1px; }
.badge.danger { background: rgba(255,255,255,.15); color: white; }
.badge.warning { background: #fff1d9; color: #8b5b09; }
.badge.success { background: #e5f5ef; color: #1e7562; }
.hero-alert h3 { margin: 12px 0 8px; font-size: 31px; }
.hero-alert p { margin: 0; max-width: 750px; line-height: 1.58; opacity: .9; }
.hero-meta { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 17px; font-size: 11px; opacity: .82; }
.hero-actions { display: flex; gap: 10px; margin-top: 21px; }
button.primary, button.secondary { border-radius: 10px; padding: 11px 16px; font-weight: 750; border: 1px solid transparent; }
